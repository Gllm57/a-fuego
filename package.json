{
  "name": "a-fuego",
  "version": "1.0.0",
  "description": "¡A Fuego! — juego de cocina para celular con backend autoritativo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test 'server/test/**/*.test.js'",
    "build:static": "node scripts/build-static.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
